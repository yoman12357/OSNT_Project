+        path.rli_cwin_limit != ca_start_cwin + path.send_mtu ||
+        !path.was_cwin_limited_by_rli) {
+        DBG_PRINTF("RLI Congestion Avoidance cap failed, cwin=%llu, expected=%llu, limit=%llu",
